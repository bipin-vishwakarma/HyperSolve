      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">Workspace</button><button>Connections</button><button>Settings</button></nav>",
      "css": ".ds-nav{background:#191e2e;width:198px;padding:14px} .ds-nav button{font-family:Segoe UI,sans-serif;font-size:14px;display:block;width:100%;text-align:left;padding:12px 13px;border:0;border-radius:5px;background:transparent;color:#bdc5d9;font-weight:600} .ds-nav button:hover{background:#252c42;color:white} .ds-nav button[aria-current]{background:#313c60;color:white} .ds-nav button:focus-visible{outline:2px solid #3759dc}"
