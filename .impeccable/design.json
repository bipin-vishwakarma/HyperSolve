    },
    {
      "name": "Task Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat task grouping.",
      "html": "<section class=\"ds-panel\"><h3>Current session</h3><p>Choose a browser tab to get started.</p></section>",
      "css": ".ds-panel{font-family:Segoe UI,sans-serif;font-size:14px;background:white;color:#24293b;border:1px solid #dfe3ed;border-radius:8px;padding:20px 22px} .ds-panel h3{font-size:16px;font-weight:600;margin:0 0 12px} .ds-panel p{margin:0;color:#606b82}"
