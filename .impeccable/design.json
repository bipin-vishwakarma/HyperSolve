      "kind": "custom",
      "refersTo": "workbench",
      "description": "Results-first empty state with a browser-tab/checkmark illustration and collapsed activity log.",
      "html": "<section class=\"ds-workbench\"><h3>Results</h3><div class=\"ds-empty\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 96 72\"><rect x=\"6\" y=\"7\" width=\"65\" height=\"47\" rx=\"7\" fill=\"#e9edfb\" stroke=\"#b6c3f2\" stroke-width=\"2\"/><rect x=\"24\" y=\"20\" width=\"65\" height=\"47\" rx=\"7\" fill=\"#fff\" stroke=\"#3759dc\" stroke-width=\"2\"/><path d=\"M24 32h65\" stroke=\"#3759dc\" stroke-width=\"2\"/><path d=\"m45 49 7 7 15-15\" fill=\"none\" stroke=\"#3759dc\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><h4>A clear view of every answer</h4><p>Choose your source tab above. Questions and selected answers will appear here as the session runs.</p></div><details class=\"ds-log\"><summary>Show activity log</summary><pre>Session activity appears here.</pre></details></section>",
      "css": ".ds-workbench{background:white;color:#24293b;border:1px solid #dfe3ed;border-radius:9px;padding:22px 22px 18px;font:14px Segoe UI,sans-serif}.ds-workbench h3{font-size:16px;margin:0;font-weight:600}.ds-empty{text-align:center;padding:28px 20px}.ds-empty svg{width:80px;height:64px}.ds-empty h4{font-size:21px;font-weight:600;color:#303b5a;margin:14px 0}.ds-empty p{color:#606b82}.ds-log summary{padding:6px 0;color:#3c4f83;cursor:pointer}.ds-log summary:hover{color:#2945b5}.ds-log summary:focus-visible{outline:1px solid #3759dc}.ds-log pre{font:12px Cascadia Mono,Consolas,monospace;border:1px solid #dfe3ed;border-radius:5px;padding:10px;height:90px}"
    }
  ],
  "narrative": {
    "northStar": "Windows Operate",
    "overview": "The Windows Operate utility is a calm, practical workspace. A light working surface and dark persistent sidebar separate tasks from navigation. Cobalt marks primary actions and observed status; typography and spacing carry the hierarchy.\n\nThe application retains the standard Windows titlebar and uses native PyQt6 controls with the Fusion widget style. This document captures the implemented desktop, with dashboard_window.py as the source authority; browser HUD styling is a separate surface.",
    "keyCharacteristics": [
      "Light workbench with a persistent ink rail and cobalt actions.",
      "Results-first workbench, live setup guidance, and an expandable activity log.",
      "Flat panels, cobalt actions, and standard Windows framing."
    ],
    "rules": [],
    "dos": [
      "Do retain the ink-and-cobalt workbench, dark persistent sidebar, and standard OS titlebar.",
      "Do use Segoe UI for interface text and monospace only for diagnostic activity.",
      "Do retain visible keyboard focus and readable disabled states.",
      "Do describe connection and session states using observed facts."
    ],
    "donts": [
      "Don't add decorative shadows or motion to this flat utility without a new design decision.",
      "Don't replace native window controls with a custom titlebar.",
      "Don't imply that a detected provider tab proves sign-in or answer accuracy."
    ]
  }
}
