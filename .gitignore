# HyperSolve Security & Environment Exclusions
# CRITICAL: Prevent personal Chrome credentials and cookies from ever being pushed
chrome_profile/
chrome_profile/*
userData/
*.session

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# Environment variables & API keys
.env
.env.*
secrets.json

# Logs & temporary files
*.log
*.tmp
temp/
scratch/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
