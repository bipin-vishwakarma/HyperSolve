{
  "manifest_version": 3,
  "name": "HyperSolve Browser Companion",
  "version": "3.0.0",
  "description": "Detect quizzes, confirm solving, and manage an independent agent for each tab.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HyperSolve"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "parser.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
